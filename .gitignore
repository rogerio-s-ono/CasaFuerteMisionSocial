# === Segredos ===
# NOTA: el repo es PÚBLICO y se sirve por GitHub Pages, así que app/config.js DEBE
# versionarse (el app estático lo necesita en el servidor). El SYNC_TOKEN queda expuesto
# (inevitable en un frontend público) — la seguridad real es login Google + allowlist en el
# servidor. NUNCA se versionan datos personales ni los *.real (con secretos fuertes).
*.real
*.local

# Credenciais / chaves
*.key
*.pem
.env
.env.*
service-account*.json
credentials*.json

# Dados pessoais reais de voluntários/beneficiários — nunca no repo
app/data-real.json
*-real.json

# === Sistema / editor ===
.DS_Store
Thumbs.db
*.log
node_modules/
.vscode/
.idea/
*.swp

# Backend secrets
backend/Code.gs.real
app/config.js.real
config.js.real
